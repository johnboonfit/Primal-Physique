# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings > API in the Supabase dashboard).
#
# These are safe to embed in the app — the EXPO_PUBLIC_ prefix means Expo
# bundles them into the client. Security comes from Row Level Security (RLS)
# policies in the database, not from hiding these values.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Free key from fdc.nal.usda.gov/api-key-signup — used for typed food
# search (generic whole foods like "chicken breast" or "rice"), which
# Open Food Facts is weak at since it's built for barcoded packaged
# products. Same "safe to embed" reasoning as above: this just avoids
# USDA's stricter shared-anonymous rate limit, it isn't a secret.
EXPO_PUBLIC_USDA_FDC_API_KEY=your-usda-fdc-api-key
